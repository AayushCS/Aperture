{
  "name": "@aperture/orbital-core",
  "version": "0.2.0",
  "description": "Launch window planning engine: plane-crossing solver, J2 precession, solar ephemeris, ascent visibility and weather risk",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "satellite.js": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "1.2.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "keywords": ["orbital", "mechanics", "satellite", "launch", "window"],
  "license": "MIT"
}
